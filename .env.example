# --- Jellyfin ---------------------------------------------------------------
# An admin API key is required: POST /Items/{itemId} is gated on the
# RequiresElevation policy. Create one in Dashboard -> API Keys.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

# --- Last.fm ----------------------------------------------------------------
# Read-only usage: only an API key is needed, no user auth or session signing.
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USER_AGENT=metaedit/0.1.0 (+https://github.com/your-user/metaedit)

# --- Database ---------------------------------------------------------------
POSTGRES_USER=metaedit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=metaedit
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://metaedit:change-me@localhost:5432/metaedit
# Host-side URL used by `uv run alembic` / `metaedit` when Postgres runs in compose
# DATABASE_URL=postgresql+psycopg://metaedit:change-me@localhost:5432/metaedit

# --- Archive ----------------------------------------------------------------
ARCHIVE_ENABLED=true
ARCHIVE_LOG_REQUESTS=true
# The Last.fm ToS "Reasonable Usage Cap" is 100 MiB of stored Last.fm Data.
ARCHIVE_SOFT_CAP_BYTES=104857600
ARCHIVE_WARN_RATIO=0.8
ARCHIVE_FRESHNESS_TTL_S=86400

# --- Mapping policy ---------------------------------------------------------
LASTFM_MIN_TAG_COUNT=0
LASTFM_GENRE_LIMIT=5
LASTFM_STYLE_LIMIT=10
MAX_TAGS_PER_ITEM=30
MAX_TAG_LENGTH=100
TAG_BLACKLIST_EXTRA=

# --- App --------------------------------------------------------------------
APP_BIND=127.0.0.1
APP_PORT=8080
LOG_LEVEL=INFO
LOG_JSON=true
