# The stand-in services for the end-to-end stack: a stub Jellyfin and a stub Last.fm.
#
# One Dockerfile for both, parameterised by module, rather than two near-identical files.
# Deliberately its own file rather than a stage of the app's Dockerfile, because it must
# never be part of a deployable image: shipping a service that impersonates Jellyfin would
# be a serious mistake to make available by accident.
FROM docker.io/library/python:3.12-slim

ARG STUB_MODULE=stub_jellyfin.py
ARG STUB_PORT=8096

RUN pip install --no-cache-dir "fastapi==0.115.6" "uvicorn[standard]==0.34.0"

WORKDIR /stub
COPY tests/e2e/stub_jellyfin.py tests/e2e/stub_lastfm.py ./

# Promoted to env: a build ARG is not visible to the runtime CMD, so `sh -c "python
# ${STUB_MODULE}"` expanded to `python` with no argument and the container exited 0.
ENV STUB_PORT=${STUB_PORT}
ENV STUB_MODULE=${STUB_MODULE}
EXPOSE ${STUB_PORT}

# Non-root, like the real image. The source is copied before the user exists, so it has to
# be handed over explicitly -- otherwise the unprivileged process cannot read it.
RUN useradd --uid 10002 --no-create-home --shell /usr/sbin/nologin stub \
    && chown -R 10002:10002 /stub
USER 10002

HEALTHCHECK --interval=5s --timeout=3s --retries=10 \
    CMD python -c "import os,urllib.request;urllib.request.urlopen(f'http://127.0.0.1:{os.environ[\"STUB_PORT\"]}/health')"

CMD ["sh", "-c", "exec python ${STUB_MODULE}"]
